DATABASE_URL="postgresql://postgres:password@localhost:5432/salmi?schema=public?connection_limit=10"
# For production, use Neon/Supabase: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32  (MIN 32 chars, unique per env)
NEXTAUTH_SECRET="CHANGE-ME-generate-with-openssl-rand-base64-32"
# Admin credentials - MUST CHANGE BEFORE PRODUCTION
ADMIN_USERNAME=admin123
ADMIN_PASSWORD="change-me-strong-password-min-16-chars"
# Optional - for production image uploads (if not set, images saved locally + base64 fallback)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
